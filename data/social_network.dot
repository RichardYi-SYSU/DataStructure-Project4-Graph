graph social_network {

    // 布局设置
    graph [
        layout=neato;
        overlap=false;
        splines=true;
        sep=1.2;
        esep=0.8;
        K=1.5;
        fontsize=18;
        labelloc="t";
    ];

    // 节点样式
    node [
        shape=circle;
        style=filled;
        fillcolor="#4e79a7";
        width=0.6;
        height=0.6;
        fontsize=10;
        fontname="Microsoft YaHei";
        color=white;
        penwidth=1.5;
    ];
    //边样式
    edge [
        color="#e15759";
        penwidth=2.5;
        fontsize=9;
        fontname="Microsoft YaHei";
    ];


    // 边定义 (权重1-10)
    1 -- 2 [label="8"];
    1 -- 3 [label="7"];
    1 -- 4 [label="9"];
    2 -- 5 [label="6"];
    2 -- 6 [label="8"];
    3 -- 7 [label="5"];
    3 -- 8 [label="7"];
    4 -- 9 [label="8"];
    4 -- 10 [label="6"];
    5 -- 11 [label="7"];
    5 -- 12 [label="9"];
    6 -- 13 [label="6"];
    6 -- 14 [label="8"];
    7 -- 15 [label="7"];
    7 -- 16 [label="5"];
    8 -- 17 [label="8"];
    8 -- 18 [label="6"];
    9 -- 19 [label="9"];
    9 -- 20 [label="7"];
    10 -- 21 [label="6"];
    10 -- 22 [label="8"];
    11 -- 23 [label="7"];
    11 -- 24 [label="5"];
    12 -- 25 [label="8"];
    12 -- 26 [label="6"];
    13 -- 27 [label="7"];
    13 -- 28 [label="9"];
    14 -- 29 [label="6"];
    14 -- 30 [label="8"];
    15 -- 31 [label="7"];
    15 -- 32 [label="5"];
    16 -- 33 [label="8"];
    16 -- 34 [label="6"];
    17 -- 35 [label="9"];
    17 -- 36 [label="7"];
    18 -- 37 [label="6"];
    18 -- 38 [label="8"];
    19 -- 39 [label="7"];
    19 -- 40 [label="5"];
    20 -- 21 [label="8"];
    22 -- 23 [label="7"];
    24 -- 25 [label="6"];
    26 -- 27 [label="9"];
    28 -- 29 [label="7"];
    30 -- 31 [label="5"];
    32 -- 33 [label="8"];
    34 -- 35 [label="6"];
    36 -- 37 [label="7"];
    38 -- 39 [label="8"];
    40 -- 1 [label="6"];
    2 -- 9 [label="7"];
    3 -- 12 [label="8"];
    5 -- 15 [label="6"];
    7 -- 20 [label="7"];
    10 -- 25 [label="9"];
    13 -- 30 [label="5"];
    18 -- 28 [label="8"];
    22 -- 35 [label="6"];
    26 -- 40 [label="7"];
}