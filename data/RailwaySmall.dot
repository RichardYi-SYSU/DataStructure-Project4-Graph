graph china_hsr_minimum {
    // 布局设置
    graph [
        layout=neato;
        overlap=false;
        splines=true;
        sep=1.2;
        esep=0.8;
        K=1.5;
        fontsize=18;
        labelloc="t";
    ];
    
    // 节点样式
    node [
        shape=circle;
        style=filled;
        fillcolor="#4e79a7";
        width=0.6;
        height=0.6;
        fontsize=10;
        fontname="Microsoft YaHei";
        color=white;
        penwidth=1.5;
    ];
    //边样式
    edge [
        color="#e15759";
        penwidth=2.5;
        fontsize=9;
        fontname="Microsoft YaHei";
    ];
    
    // 节点定义
    1  [label="1北京"];
    2  [label="2上海"];
    3  [label="3天津"];
    4  [label="4西安"];
    5  [label="5哈尔滨"];
    6  [label="6南京"];
    7  [label="7苏州"];
    8  [label="8济南"];
    9  [label="9郑州"];
    10 [label="10广州"];
    11 [label="11合肥"];
    12 [label="12青岛"];
    13 [label="13太原"];
    14 [label="14武汉"];
    15 [label="15深圳"];
    16 [label="16福州"];
    17 [label="17南昌"];
    18 [label="18长春"];
    19 [label="19重庆"];
    20 [label="20昆明"];
    21 [label="21贵阳"];
    22 [label="22南宁"];
    23 [label="23厦门"];
    24 [label="24宁波"];
    25 [label="25成都"];
    26 [label="26兰州"];
    27 [label="27西宁"];
    28 [label="28长沙"];
    29 [label="29大连"];
    30 [label="30乌鲁木齐"];
    31 [label="31银川"];
    32 [label="32香港"];
    
    // 关键骨干线路 
    1 -- 2 [label="1318"];    // 京沪线
    1 -- 10 [label="2298"];   // 京广线
    1 -- 5 [label="1248"];   // 京哈线
    1 -- 4 [label="1211"];   // 京西线
    1 -- 3 [label="120"];    // 京津
    1 -- 8 [label="410"];    // 京济
    1 -- 9 [label="693"];    // 京郑
    2 -- 6 [label="295"];    // 沪宁
