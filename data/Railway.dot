graph Railway{

    // 布局设置
    graph [
        layout=neato;
        overlap=false;
        splines=true;
        sep=1.2;
        esep=0.8;
        K=1.5;
        fontsize=18;
        labelloc="t";
    ];
    
    // 节点样式
    node [
        shape=circle;
        style=filled;
        fillcolor="#4e79a7";
        width=0.6;
        height=0.6;
        fontsize=10;
        fontname="Microsoft YaHei";
        color=white;
        penwidth=1;
    ];
    //边样式
    edge [
        color="#e15759";
        penwidth=1.5;
        fontsize=7;
        fontname="Microsoft YaHei";
    ];
    


    // ===== 节点定义 =====
    1  [label="1北京"];
    2  [label="2上海"];
    3  [label="3天津"];
    4  [label="4西安"];
    5  [label="5哈尔滨"];
    6  [label="6南京"];
    7  [label="7苏州"];
    8  [label="8济南"];
